# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/bettercoop

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Africa's Talking SMS (FR-06) ─────────────────────────────────────────────
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox          # use 'sandbox' for testing, your username for production
AT_SENDER_ID=BetterCOOP      # shortcode / sender registered with AT

# ─── NOT HERE (out of scope) ─────────────────────────────────────────────────
# No KRA / tax keys
# No payment gateway keys
# No mobile-money keys
